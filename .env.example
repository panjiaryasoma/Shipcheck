# Gemini / Google
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional GitHub token for higher public API rate limits.
GITHUB_TOKEN=

# Shipcheck
SHIPCHECK_MODEL=gemini-3.7-flash
SHIPCHECK_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
SHIPCHECK_ENV=development
# HTTP fetch timeout for rules/repository/deployment requests.
SHIPCHECK_REQUEST_TIMEOUT_SECONDS=20
# Per-Gemini-model timeout. Kept separate because ADK structured extraction can take longer.
SHIPCHECK_MODEL_TIMEOUT_SECONDS=60
SHIPCHECK_RULES_CACHE_TTL_SECONDS=3600
# Only this repository may treat Shipcheck's own Firestore audit write as target-project evidence.
SHIPCHECK_SELF_REPOSITORY_URL=https://github.com/panjiaryasoma/Shipcheck

# Optional Firestore audit persistence.
SHIPCHECK_FIRESTORE_ENABLED=false
SHIPCHECK_FIRESTORE_DATABASE=(default)
SHIPCHECK_FIRESTORE_COLLECTION=shipcheck_inspections
